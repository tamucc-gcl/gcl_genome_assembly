/*
========================================================================================
    Self-contained config for the STANDALONE short-read organelle assembly test.
========================================================================================
    Replicates only the scheduler + conda settings the GetOrganelle processes need, so the
    test runs WITHOUT touching your nextflow.config. When you integrate for real, copy the
    params + withLabel blocks below into nextflow.config and drop this file.
========================================================================================
*/

conda {
    enabled       = true
    cacheDir      = '/work/birdlab/.conda_builds'
    channels      = ['conda-forge', 'bioconda', 'defaults']
    createTimeout = '6 h'
}

params {
    getorganelle_downloads       = '/work/birdlab/databases/getorganelle'
    getorganelle_force_download  = false
    getorganelle_organelle_types = null
    getorganelle_coverage        = null
    getorganelle_recursion       = null
    getorganelle_kmers           = null
    getorganelle_word_size       = null
    getorganelle_from_assembly   = true
    getorganelle_min_depth       = 10
    getorganelle_extra_args      = ''
    outdir                       = './results_orgtest'
    publish_dir_mode             = 'link'
}

process {
    executor      = 'slurm'
    queue         = 'normal'
    scratch       = '/scratch'
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: getorganelle {
        conda  = 'bioconda::getorganelle=1.7.7.1'
        cpus   = 16
        memory = '32 GB'
        time   = '8h'
        queue  = 'normal'
    }
    withLabel: getorganelle_download {
        conda  = 'bioconda::getorganelle=1.7.7.1'
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }
}

executor {
    queueSize = 50
}
