/*
    Self-contained config for the STANDALONE short-read organelle test (assembly + annotation).
    Carries the scheduler + conda settings, the params, and the process labels — so the test
    runs without touching your nextflow.config. Copy the params + withLabel blocks into
    nextflow.config when integrating for real.
    NOTE: the chloe label points at chloe.yml sitting NEXT TO this config (test/). In production
    it lives at envs/chloe.yml (adjust the path in nextflow.config accordingly).
*/

conda {
    enabled       = true
    cacheDir      = '/work/birdlab/.conda_builds'
    channels      = ['conda-forge', 'bioconda', 'defaults']
    createTimeout = '6 h'
}

params {
    // GetOrganelle (assembly)
    getorganelle_downloads       = '/work/birdlab/databases/getorganelle'
    getorganelle_force_download  = false
    getorganelle_organelle_types = null
    getorganelle_coverage        = null
    getorganelle_recursion       = null
    getorganelle_kmers           = null
    getorganelle_word_size       = null
    getorganelle_from_assembly   = true
    getorganelle_min_depth       = 10
    getorganelle_extra_args      = ''

    // MITOS2 (mito annotation)
    mitos_downloads              = '/work/birdlab/databases/mitos'
    mitos_refseq_sets            = 'refseq89m,refseq89f'
    mitos_force_download         = false
    mitos_refseq                 = null

    // shared
    outdir                       = './results_orgtest'
    publish_dir_mode             = 'link'
}

process {
    executor      = 'slurm'
    queue         = 'normal'
    scratch       = '/scratch'
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: getorganelle {
        conda  = 'bioconda::getorganelle=1.7.7.1'
        cpus   = 16
        memory = '32 GB'
        time   = '8h'
        queue  = 'normal'
    }
    withLabel: getorganelle_download {
        conda  = 'bioconda::getorganelle=1.7.7.1'
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }
    withLabel: mitos {
        conda  = 'bioconda::mitos=2.1.10'
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
        queue  = 'normal'
    }
    withLabel: mitos_download {
        conda  = 'conda-forge::curl conda-forge::tar conda-forge::bzip2'
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }
    withLabel: tiny {
        cpus   = 1
        memory = '500 MB'
        time   = '15m'
    }
}

executor {
    queueSize = 50
}
