// Diagnostic override for clusters that schedule cores without reserving memory.
// Apply with -c; do not incorporate these settings into production defaults.
process {
    withLabel: 'harmonize_scaffolds' {
        cpus = 8
        memory = '300 GB'
        time = '8h'
        queue = 'normal'
        clusterOptions = '--exclusive'
        maxForks = 1
        errorStrategy = 'terminate'
    }
}
