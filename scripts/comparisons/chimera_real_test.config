// Use the activated analysis environment; all work stays inside this SLURM allocation.
process.executor = 'local'
conda.enabled = false
executor.cpus = 16
executor.memory = '90 GB'
process {
    withLabel: chimera_sequence_context { cpus=8; memory='32 GB'; time='24h' }
    withLabel: chimera_evidence { cpus=2; memory='12 GB'; time='24h' }
    withLabel: chimera_joins { cpus=1; memory='8 GB'; time='2h' }
    withLabel: break_chimeras { cpus=1; memory='12 GB'; time='2h' }
    withLabel: harmonize_scaffolds { cpus=16; memory='64 GB'; time='24h' }
}
params {
    chimera_recover_older = false
    chimera_hifi_context = true
    harmonize_two_pass_selection = false
    publish_dir_mode = 'copy'
}
