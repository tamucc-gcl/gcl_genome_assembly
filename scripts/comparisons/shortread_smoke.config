// Explicit test-only overrides. Never include from the production configuration.
// Native routing/failure pilot: lower nuclear read depth, one k-mer round and
// read correction. The old uncorrected K21/33 run exhausted ~733 GB at pairing.
// This does not establish production assembly quality or guarantee a short runtime.
params {
    qc_mode = 'none'
    run_post_assembly = false
    run_pangenome = false
    run_final_hifi_mapping = false
    run_blobtools_evidence = false
    shortread_target_depth = 15
    spades_kmer_list = '55'
    spades_mode = ''
    spades_cov_cutoff = 'auto'
    spades_extra = ''
    run_redundans_reduction = true
    run_redundans_scaffolding = true
    run_redundans_gapclosing = true
    redundans_iters = 1
}
// Inherit production CPU, memory, queue, retry and time settings.
