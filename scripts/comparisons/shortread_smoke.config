// Explicit test-only overrides. Never include from the production configuration.
params {
    qc_mode = 'none'
    run_post_assembly = false
    run_pangenome = false
    run_final_hifi_mapping = false
    run_blobtools_evidence = false
    spades_kmer_list = '21,33'
    spades_mode = ''
    spades_cov_cutoff = 'off'
    spades_extra = '--only-assembler'
    run_redundans_reduction = true
    run_redundans_scaffolding = true
    run_redundans_gapclosing = true
    redundans_iters = 1
}
// Inherit production CPU, memory, queue, retry and time settings.
