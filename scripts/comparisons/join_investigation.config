// An isolated diagnostic: do not inherit production workflows or process selectors.
process.executor = 'slurm'
process.queue = 'normal'
process.errorStrategy = 'terminate'
process.maxForks = 4
executor.queueSize = 8
// Inputs remain in the shared, retained Nextflow cache. Only small job files and
// diagnostic packets are staged; no assembly or read dataset is copied.
process.scratch = false
timeline.enabled = false
dag.enabled = false
trace.overwrite = true
report.overwrite = true
