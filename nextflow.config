
params {

    // ── Resources / run ────────────────────────────────────────────────
    max_cpus              = 64
    max_memory            = '700 GB'
    max_time              = '240.h'
    outdir                = './results'
    sample_sheet          = null
    publish_dir_mode      = 'link'
    qc_mode               = 'final_only'          // 'all_stages' | 'final_only'

    // ── Organism identity (taxid primary; rest derived, all overridable) ─
    taxid                 = null                  // sheet `taxid` column overrides per-sample
    species               = null                  // optional name override; else derived from taxid
    mitochondria_genetic_code = null     // derived from taxonomy (kingdom); override with an integer
    telomere_motif = null     // organism telomere repeat; derived from taxonomy (clade), override with a motif string

    // ── Assembly strategy (column ▸ global param ▸ derived default) ──────
    assembler             = null
    ploidy                = null                //Expected ploidy of assembly. column overrides per-sample
    n_hap                 = null                 // derived from ploidy; override with an integer
    haploid_genome_size = 'auto'     // organism haploid size; null = GenomeScope estimate, 'auto' = hifiasm's own, or a bp value
    dedup                 = null
    mito_tool             = null

    // ── QC verdict thresholds (report status column) ──
    qc_flag_busco    = 90
    qc_flag_qv       = 40
    qc_flag_kmer     = 90
    qc_flag_size_pct = 0

    // Contiguity gate. `auN pieces` = total length / auN, the length-weighted effective
    // piece count. Bars are tier-keyed because an absolute contiguity threshold is
    // meaningless across HiFi+Hi-C / HiFi-only / short-read. 0 disables any individual bar.
    qc_flag_aun_mult             = 2.0   // hifi+hic: auN pieces <= mult x expected chromosome count
    qc_flag_aun_pieces_contig    = 500   // hifi, no Hi-C: catastrophe floor, not a grade
    qc_flag_aun_pieces_shortread = 0     // short-read: off; no defensible default
    qc_flag_largest_frac         = 0.5   // largest scaffold >= frac x mean chromosome length
    qc_flag_largest_upper        = 1.5   // advisory only: possible over-join above this
    qc_flag_cohort_mad           = 3.0   // outlier vs (taxid, tier) cohort; needs n >= 4
    qc_expected_chrom_count      = 0     // 0 = derive from the harmonization name map

    // ── Shared analysis k-mer (GenomeScope + Merqury) ───────────────────
    kmer_size             = 21                     // was genomescope_kmer + merqury_k

    // ── hifiasm: overlap / error correction ─────────────────────────────
    hifiasm_kmer_length            = 51
    hifiasm_minimizer_window       = 51
    hifiasm_bloom_filter_bits      = 37
    hifiasm_kmer_drop_factor       = 5.0
    hifiasm_max_overlaps           = 100
    hifiasm_correction_rounds      = 3
    hifiasm_adapter_trim_bp        = 0
    hifiasm_max_kmer_occurrence    = 2000
    // ── hifiasm: assembly ───────────────────────────────────────────────
    hifiasm_cleaning_rounds        = 4
    hifiasm_contig_bubble_bp       = 10000000
    hifiasm_unitig_bubble_bp       = 0
    hifiasm_tip_unitig_reads       = 3
    hifiasm_max_overlap_drop_ratio = 0.8
    hifiasm_min_overlap_drop_ratio = 0.2
    hifiasm_post_join              = 1
    hifiasm_homozygous_coverage    = 'auto'
    hifiasm_low_quality_percent    = 70
    hifiasm_break_low_coverage     = 0
    hifiasm_break_high_coverage    = -1
    hifiasm_break_mismatch_rate    = 0.75
    hifiasm_primary                = false
    hifiasm_tip_contig_reads       = 3
    // ── hifiasm: purge-dups ─────────────────────────────────────────────
    hifiasm_purge_level            = 3
    hifiasm_purge_similarity       = 0.55
    hifiasm_purge_min_overlap      = 1
    hifiasm_purge_max_coverage     = 'auto'
    // ── hifiasm: Hi-C partition ─────────────────────────────────────────
    hifiasm_use_hic                = true
    hifiasm_hic_base_similarity    = 0.5
    hifiasm_hic_reweight_rounds    = 3
    hifiasm_hic_perturb_rounds     = 10000
    hifiasm_hic_perturb_fraction   = 0.1
    hifiasm_misjoin_detect_bp      = 500000
    // ── hifiasm: dual-scaffolding ───────────────────────────────────────
    hifiasm_dual_scaffolding       = false
    hifiasm_scaffold_max_gap_bp    = 3000000
    // ── hifiasm: telomere ───────────────────────────────────────────────
    hifiasm_telo_penalty           = 1
    hifiasm_telo_max_drop          = 2000
    hifiasm_telo_min_score         = 500

    // ── MitoHiFi ────────────────────────────────────────────────────────
    mitohifi_ref_min_bp            = 14000
    mitohifi_perc_identity         = 50
    mitohifi_cov_cutoff            = 'auto'
    mitohifi_bloom_filter          = false
    mitohifi_circular_map_dpi      = 300
    mitohifi_filter_min_identity   = 90
    mitohifi_filter_min_coverage   = 50

    // ── GetOrganelle (short-read organelle assembly) ────────────────────
    getorganelle_downloads         = '/work/birdlab/databases/getorganelle'
    getorganelle_force_download    = false
    getorganelle_organelle_types   = null   // override taxonomy-derived -F, e.g. 'embplant_pt,embplant_mt'
    getorganelle_coverage          = null   // override --reduce-reads-for-coverage target (int)
    getorganelle_recursion         = null   // override -R (int)
    getorganelle_kmers             = null   // override -k (e.g. '21,45,65,85,105,127')
    getorganelle_word_size         = null   // override -w; null => GetOrganelle auto-estimates
    getorganelle_from_assembly     = true   // if the reads run yields no circle, prune graph and retry
    getorganelle_min_depth         = 10     // depth floor for the from-assembly prune
    getorganelle_extra_args        = ''     // extra get_organelle_from_reads.py flags

    // ── MITOS2 (metazoan/fungal mito annotation) ────────────────────────
    mitos_downloads      = '/work/birdlab/databases/mitos'   // parent dir for refseqNNx sets (auto-downloaded)
    mitos_refseq_sets    = 'refseq89m,refseq89f'             // sets fetched from Zenodo
    mitos_force_download = false
    mitos_refseq         = null                              // override the clade-derived set

    // ── short-read / subsample ──────────────────────────────────────────
    shortread_target_depth          = 60 // target coverage; 0/null = disabled (pass through)/If depth is already below target, no subsampling is done
    shortread_subsample_seed        = 42 // deterministic

    // ── SPAdes ──────────────────────────────────────────────────────────
    spades_kmer_list               = '21,33,55,77'
    spades_cov_cutoff              = 'auto'
    spades_mode                    = '--isolate'
    spades_extra                   = ''
    spades_output_level            = 'scaffolds'

    spades_mem_base_gb    = 30      // baseline overhead
    spades_mem_per_gbp    = 1.0     // GB per Gbp input — read-mapping regime (small/low-repeat genomes)
    spades_mem_per_geno2  = 340     // GB per (Gbp genome)^2 — graph/paired-info regime (super-linear)
    spades_mem_safety     = 1.3
    spades_mem_unknown_gb = 500     // no genome estimate -> conservative (bigmem)
    // per-partition usable ceilings — set from sinfo (see command below), minus ~10-15% margin
    spades_normal_max_gb = 320    // normal RealMemory 342.7 GiB — leave ~23
    spades_bigmem_max_gb = 680    // bigmem RealMemory 700.4 GiB — leave ~20
    spades_ultra_max_gb  = 1380   // ultramem RealMemory 1415.6 GiB — leave ~36

    // ── GenomeScope / jellyfish ─────────────────────────────────────────
    jellyfish_hash_size            = '5G'

    // ── purge_dups ──────────────────────────────────────────────────────
    run_purge_dups                 = false

    // ── redundans ───────────────────────────────────────────────────────
    run_redundans_reduction        = true
    run_redundans_scaffolding      = true
    run_redundans_gapclosing       = true
    redundans_identity             = 0.51
    redundans_overlap              = 0.80
    redundans_min_contig_bp        = 200
    redundans_joins                = 5
    redundans_linkratio            = 0.7
    redundans_limit                = 0.2
    redundans_mapq                 = 10
    redundans_iters                = 2
    redundans_preset               = 'asm5'
    redundans_index                = '4G'
    redundans_minimap2reduce       = false
    redundans_minimap2scaffold     = false
    redundans_usebwa               = false
    redundans_populate_scaffolds   = false
    redundans_norearrangements     = false
    redundans_extra                = ''

    // ── short-read / fastp ──────────────────────────────────────────────
    run_shortread_trim               = true
    shortread_fastp_cut_tail_quality = 20
    shortread_fastp_cut_tail_window  = 4
    shortread_fastp_length_required  = 30
    shortread_fastp_extra            = ''

    // ── pilon ───────────────────────────────────────────────────────────
    run_pilon                      = false
    pilon_fix                      = 'all'
    pilon_rounds                   = 1
    pilon_extra                    = ''

    // ── BUSCO ───────────────────────────────────────────────────────────
    busco_lineage                  = 'eukaryota_odb10'   // fallback; primary is per-sample from taxonomy
    busco_downloads                = '/work/birdlab/databases/busco'

    // ── inspector: contigs ──────────────────────────────────────────────
    run_inspector_contigs                   = true
    inspector_contig_base_error_check       = false      // was skip_baseerror=true (flipped)
    inspector_contig_min_depth              = null
    inspector_contig_min_contig_bp          = 10000
    inspector_contig_assemblyerror_min_bp   = 1000000
    inspector_contig_min_assembly_error_bp  = 50
    inspector_contig_max_assembly_error_bp  = 4000000
    // ── inspector: scaffolds ────────────────────────────────────────────
    run_inspector_scaffolds                  = true
    inspector_scaffold_base_error_check      = false      // was skip_baseerror=true (flipped)
    inspector_scaffold_min_depth             = null
    inspector_scaffold_min_contig_bp         = 10000
    inspector_scaffold_assemblyerror_min_bp  = 10000000
    inspector_scaffold_min_assembly_error_bp = 50
    inspector_scaffold_max_assembly_error_bp = 10000000

    // ── Hi-C mapping / contact maps ─────────────────────────────────────
    bwa_mem2_hic_args              = ''
    hic_coverage_window            = 100000
    hic_min_mapq                   = 30
    hic_resolutions                = '2500000,1000000,500000,250000,100000,50000,10000'
    hic_base_bin                   = '10000'
    hic_plot_resolutions           = '1000000,500000,250000,100000'
    run_hic_balance                = true
    hic_min_mapq_raw               = 30
    hic_min_mapq_filtered          = 1
    scaffold_min_bp                = 0

    // ── YaHS round 1 ────────────────────────────────────────────────────
    yahs_round1_min_contig_bp          = 20000
    yahs_round1_min_mapq               = 10
    yahs_round1_resolutions            = '20000,50000,100000,200000,500000,1000000,2000000,5000000,10000000,20000000,50000000,100000000,200000000'
    yahs_round1_rounds_per_resolution  = null
    yahs_round1_enzyme                 = null
    yahs_round1_contig_ec              = true            // was no_contig_ec=false (flipped)
    yahs_round1_scaffold_ec            = true            // was no_scaffold_ec=false (flipped)
    // ── YaHS round 2 ────────────────────────────────────────────────────
    yahs_round2_min_contig_bp          = 100000
    yahs_round2_min_mapq               = 20
    yahs_round2_resolutions            = '50000,100000,200000,500000,1000000,2000000,5000000,10000000,20000000,50000000,100000000'
    yahs_round2_rounds_per_resolution  = null
    yahs_round2_enzyme                 = null
    yahs_round2_contig_ec              = true            // was no_contig_ec=false (flipped)
    yahs_round2_scaffold_ec            = false           // was no_scaffold_ec=true (flipped)

    // ── scaffold name harmonization ──────────────────────────────────────────────
    harmonize_scaffold_names       = true      // off => size-rank naming for all
    harmonize_minimap2_preset      = 'asm5'    // intraspecific asm-to-asm
    harmonize_min_scaffold_bp      = null      // null => finalize_min_scaffold_bp
    harmonize_min_aligned_frac     = 0.5       // min aligned fraction to place a scaffold
    harmonize_secondary_frac       = 0.2       // 2nd-chromosome share => composite/fusion
    harmonize_reference_ids        = ''        // optional pinned reference id(s), comma-sep
    harmonize_chromosome_method    = 'dropoff'  // 'dropoff' | 'threshold' (old fixed-cutoff behaviour)
    harmonize_dropoff_ratio        = 2.0        // min adjacent length ratio to accept a drop-off cut
    harmonize_dropoff_min_frac     = 0.5        // genome fraction reached before a cut is allowed
    harmonize_contained_frac       = 0.9    // a chromosome piece >= this covered by a larger piece on the same chromosome is a contained haplotig
    harmonize_demote_contained     = true   // move contained haplotigs to unplaced (false => keep as chromosome, flagged)
    harmonize_min_chrom_frac       = 0.1    // a chromosome piece < this fraction of size of a median chromosome is demoted to unplaced
    harmonize_batch_consensus      = true   // false => chromosome classification is done per-sample; true => all samples are considered together for a single consensus classification
    harmonize_batch_consensus_action = 'flag'  // 'flag' | 'demote'. What to do with a reference chromosome no voter covers. 'demote' (pre-patch behaviour) will delete a W/Y from the chromosome frame whenever the heterogametic sex is a cohort minority.
    harmonize_voter_require_dropoff = true  // voter criterion: the assembly's own chromosome set must come from a real length drop-off, not the threshold fallback
    harmonize_voter_min_genome_frac = 0.8   // voter criterion: min fraction of the assembly held in its own chromosome-scale set
    harmonize_voter_min_n50_ratio   = 0.2   // voter criterion: min scaffold N50 as a fraction of the batch median scaffold N50
    harmonize_voter_min_cut_ratio   = 0.0   // voter criterion: min drop-off cut ratio (0 = disabled; require_dropoff already implies >= harmonize_dropoff_ratio)
    harmonize_min_voters            = 3     // if fewer assemblies pass the voter criteria, disable the filter (everything votes) and flag it
    harmonize_restricted_presence_min_individuals = 2  // a chromosome covered by >= this many individuals but not all is tagged restricted_presence (sex-limited candidate) rather than reference_specific
    harmonize_concordance_exclude_reference = false  // exclude the reference from the fusion split count (a split reference otherwise votes against the fusion that reveals it is split)
    harmonize_member_cover_frac    = 0.5    // size-invariant composite-member test: a reference chromosome with >= this fraction of its own length inside a scaffold is a member of it, however small its share of that scaffold's alignment. 0 restores the share-only behaviour that hides small chromosomes joined to large ones.
    harmonize_inflated_aln_tol     = 1.05   // flag a placed scaffold when summed PAF block length / scaffold length exceeds this (repeat-driven double counting); diagnostic only
    harmonize_graph_rule           = 'majority'  // 'permissive' | 'majority' | 'plurality'. Which join-graph rule the PROVISIONAL consensus chromosome map is written under. All three are reported regardless; naming is still reference-frame derived.
    harmonize_two_pass_selection   = true    // score every candidate reference by actually aligning against it and building the join graph, then use the best. false => in-module bash heuristic (count nearest batch median, N50 tie-break). A pinned harmonize_reference_ids short-circuits both.
    harmonize_reference_candidates = 8       // cap on candidates scored, taken by descending chromosome-set genome fraction. Cost is n_candidates x n_assemblies alignments, fully parallel across candidates.
    harmonize_graph_min_fused      = 2       // join-graph support floor applied before every rule: a junction seen fused in fewer than this many voters is one observation, not evidence. At 1, a single mis-join chains unrelated chromosomes together through union-find.


    // ── finalize / contact ──────────────────────────────────────────────
    run_final_contact_maps         = true
    report_stage                   = 'final'
    finalize_min_scaffold_bp       = 1000000

    // ── Pangenome──────────────────────────────────────────────
    run_pangenome                      = false   // opt-in
    pangenome_use_gpu                  = false
    pangenome_min_haplotypes           = 2       // min kept assemblies per species to build a graph
    pangenome_max_chrom_scaffold_mult  = null    // OPTIONAL contiguity gate, OFF by default (null/false/0). When > 0, drop assemblies with more than this x (reference chromosome count) chromosome-scale scaffolds. Off because minigraph-cactus only requires the REFERENCE to be chromosome-scale: non-reference contigs are assigned to reference chromosome components by minigraph alignment and unplaceable contigs are dropped per-contig as ambiguous, so a fragmented-but-sound long-read assembly is a real individual, not an artifact.
    pangenome_allow_collapsed          = false   // COMPARABILITY gate. false => drop a collapsed (n_hap=1) assembly when the same species also has phased (n_hap=2) assemblies: a collapsed assembly is a phase mosaic, not a haplotype, so it is not a comparable unit for the graph, for panacus --groupby-haplotype, or for the ordination. When EVERY assembly of a species is collapsed the species is haploid and all are kept regardless. true => keep collapsed assemblies alongside phased ones (know why).
    pangenome_cactus_extra             = ''      // extra cactus-pangenome args
    pangenome_sv_min_bp                = 50       // SV size threshold (bp) for the variant catalog
    pangenome_vcfbub_max_ref           = 100000   // vcfbub: drop bubbles whose REF allele exceeds this
    // vcfwave realigns the block alleles vcfbub leaves behind and splits them into minimal
    // variants. Without it, `--max-level 0` discards all nested variation and the catalog
    // counts top-level blocks rather than events -- SNP/INDEL come out undercounted and
    // sv_sizes.tsv reports only |REF|-|ALT|, discarding the other allele entirely.
    pangenome_vcfwave                  = true
    // NOT tied to pangenome_vcfbub_max_ref: that cap DROPS a bubble from the catalog,
    // whereas vcfwave's -L only skips its decomposition and keeps the record. Different
    // decisions, so they get different knobs.
    //
    // vcfwave's own -L default is UNLIMITED and BiWFA cost grows superlinearly with allele
    // length. Measured on a 20k-record slice of Spratelloides, scaled to the full 41.4M
    // record catalog, SINGLE CORE:
    //
    //     -L        slice    records recovered   projected 1-core
    //     2000      0.50 s      27.7%                   0.3 h
    //     10000     7.20 s      65.3%                   4.1 h
    //     50000   146.71 s      99.9%                  84.4 h
    //     100000  165.89 s     100.0%                  95.5 h
    //
    // Default is 100000 (= no effective cap, since vcfbub already bounds REF at that) and
    // NOT the much cheaper 10000, because a cap makes the catalog heterogeneous: a 2 kb
    // block yields ~26 atomic records while a 15 kb block yields 1, so per-site statistics
    // get computed over two representations with a length-biased mix -- and length tracks
    // repeat content, so the bias lands exactly on the regions of interest. It also makes
    // SV_BLOCKSUB uninterpretable, mixing "vcfwave declined" with "never attempted".
    // Chunk-parallel execution below is what makes uniform treatment affordable.
    pangenome_vcfwave_max_len          = 100000
    // Chunks for the parallel decomposition. vcfwave is record-local (verified: splitting a
    // 23,215-record slice in half and concatenating gave byte-identical sorted output), so
    // chunks need not respect contig boundaries. More chunks than cores lets xargs schedule
    // dynamically, which matters because cost tracks allele LENGTH, not record count.
    // Defaults to task.cpus * 4 when unset.
    pangenome_vcfwave_chunks           = null
    pangenome_vcfwave_args             = '--quiet'
    pangenome_growth          = true       // run panacus openness/growth (workstream E)
    pangenome_growth_count    = 'bp'       // panacus count type: bp | node | edge
    pangenome_growth_coverage = '1,1,1'    // panacus -l  (paired position-wise with quorum)
    pangenome_growth_quorum   = '0,1,0.9'  // panacus -q  -> pangenome / core / soft-core curves
    // core / soft-core / shell / cloud cuts. Each is a MINIMUM HAPLOTYPE COUNT, expressed in
    // whichever of three forms suits the cohort:  > 1 = absolute count  |  0 < c <= 1 = fraction
    // of n  |  < 0 = n - |c| ("all but |c|").  Defaults 1.00 / -1 / 2 = all / all-but-one /
    // at-least-two, which is identical to the textbook 1.0 / 0.9 / 0.15 fractions at n = 10 but
    // does not degenerate below it: at n = 6, 0.9 rounds up to 6 and soft-core silently vanishes
    // into core, and 0.15 rounds down to 1 so shell swallows the private sequence. Switch to
    // fractions once cohorts are large enough for a frequency cut to mean something (n >~ 20).
    // The figures print the realised >=k/n for every tier, so the binning stays auditable.
    // The whole block -- the per-haplotype attribution table and all four figures -- is
    // gated on params.pangenome_growth. There is no separate toggle.
    pangenome_tier_core       = 1.00
    pangenome_tier_softcore   = -1
    pangenome_tier_shell      = 2
    pangenome_2d_viz          = true
    pangenome_qc = true    // graph-intrinsic QC diagnostics (workstream C, Tier 1)
    pangenome_multiqc = true    // pangenome MultiQC report (odgi stats + bcftools)
    pangenome_report = true    // pangenome report fragment (workstream F)
    pangenome_popstruct = true    // graph-derived PCA + NJ tree
    pangenome_progressive = false    // opt-in empirical progressive growth (minigraph)

    // ── pairwise alignment ──────────────────────────────────────────────
    run_pairwise_alignments        = true
    pairwise_alignment_preset      = 'asm5'
    pairwise_alignment_min_mapq    = 5
    pairwise_alignment_min_aln_bp  = 150000
    pairwise_alignment_mode        = 'within_sample'     // 'all' | 'within_sample'
    pairwise_dotplot_width         = 10
    pairwise_dotplot_height        = 10

    // ── riparian ────────────────────────────────────────────────────────
    riparian_min_aln_bp            = 150000
    riparian_min_seq_bp            = 1000000
    riparian_alpha                 = 0.45
    riparian_width                 = 14
    riparian_height                = 6

    // ── compartments ────────────────────────────────────────────────────
    compartment_resolution         = 250000
    compartment_min_contig_bp      = 5000000
    compartment_max_contigs        = 30

    // ── TADs ────────────────────────────────────────────────────────────
    tad_resolution                 = 50000
    tad_window_bp                  = 500000
    tad_min_contig_bp              = 5000000
    tad_max_contigs                = 0

    // ── telomere ────────────────────────────────────────────────────────
    telomere_window                = 10000
    telomere_min_repeats           = 10

    // ── teloclip ────────────────────────────────────────────────────────
    run_teloclip_extend            = true
    teloclip_min_clip              = 1
    teloclip_max_break             = 50
    teloclip_min_anchor            = 100
    teloclip_min_mapq              = 20
    teloclip_min_overhangs         = 1
    teloclip_max_homopolymer       = 500

    // ── tidk ────────────────────────────────────────────────────────────
    tidk_explore_minimum           = 5
    tidk_explore_maximum           = 12
    tidk_search_window             = 10000
    tidk_plot_height               = 200
    tidk_plot_width                = 1000

    // ── coverage book ───────────────────────────────────────────────────
    coverage_bin_bp                = 1000                // was bin_size
    coverage_min_bp                = 1000000             // was min_len
    coverage_min_mapq              = 5                   // was min_mapq

    // ── databases ───────────────────────────────────────────────────────
    db_base                        = '/work/birdlab/databases'
    gxdb_dir                       = "${params.db_base}/fcs-gx"
    gxdb_profile                   = 'all'
    gxdb_manifest                  = null
    gxdb_force                     = false
    diamond_dmnd                   = null
    diamond_dir                    = "${params.db_base}/diamond"
    diamond_name                   = 'proteins'
    diamond_taxdump_dir            = "${params.db_base}/ncbi_taxonomy"
    diamond_profile                = 'custom'
    diamond_fasta_url              = 'https://ftp.ncbi.nlm.nih.gov/blast/db/FASTA/nr.gz'
    diamond_taxonmap_url           = 'https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/accession2taxid/prot.accession2taxid.FULL.gz'
    diamond_force                  = false

    // ── decontamination ─────────────────────────────────────────────────
    run_decon_contigs              = true                // was decon_run_on_contigs
    run_decon_scaffolds            = false               // was decon_run_on_scaffolds
    run_fcs_adaptor                = false               // was decon_run_fcs_adaptor
    decon_fcsadaptor_mode          = 'euk'
    decon_container_engine         = 'singularity'
    run_blobtools_evidence         = false               // was decon_make_blobtools_evidence

    // ── decontam evidence (blobtools branch) ────────────────────────────
    evidence_map_preset            = 'map-hifi'
    evidence_diamond_max_target_seqs = 1
    evidence_diamond_evalue        = 1e-25
    evidence_blob_min_contig_bp    = 1000                // was evidence_blob_min_contig_len
}

// Derived default (was the guarded computation in main.nf ~L391).
// Keep the guard so an explicit --run_scaffold_round2 still wins.
if (!params.containsKey('run_scaffold_round2') || params.run_scaffold_round2 == null) {
    params.run_scaffold_round2 = params.run_inspector_scaffolds || params.run_decon_scaffolds
}

// Predict peak RAM (max of read-mapping and super-linear graph regimes), route to the
// SMALLEST partition whose usable ceiling holds it, and request that whole ceiling.
// Distance estimation IGNORES SPAdes' --memory cap, and SPAdes' own logged peak understates
// real OS commit by ~1.5x (COPE: logged 221 GB, committed 325 GB) — so provision to the node
// ceiling, not to the fine estimate. Recalibrate coefficients as more samples accrue.
def spadesTier = { m, attempt ->
    double inGbp = ((m?.sr_bases    ?: 0L) as double) / 1e9
    double gGbp  = ((m?.genome_size ?: 0L) as double) / 1e9

    int est
    if (gGbp > 0 || inGbp > 0) {
        double regime = Math.max((params.spades_mem_per_gbp   ?: 1.0) * inGbp,
                                 (params.spades_mem_per_geno2 ?: 340) * gGbp * gGbp)
        est = (int) Math.ceil(((params.spades_mem_base_gb ?: 30) + regime) * (params.spades_mem_safety ?: 1.3))
    } else {
        est = (params.spades_mem_unknown_gb ?: 500)
    }

    int need = est * (attempt == 1 ? 1 : 2)          // retry escalates the tier
    int nMax = params.spades_normal_max_gb ?: 300
    int bMax = params.spades_bigmem_max_gb ?: 640
    int uMax = params.spades_ultra_max_gb  ?: 1350
    if      (need <= nMax) [ mem: nMax, q: 'normal',          qos: '' ]
    else if (need <= bMax) [ mem: bMax, q: 'bigmem,ultramem', qos: '--qos=highmem' ]
    else                   [ mem: uMax, q: 'ultramem',        qos: '--qos=highmem' ]
}

// ============================================================================
// nextflow.config — COMPLETE process block
//
// Informed by traces from:
//   - Sde_CLim_110 (1 fish sample)
//   - 5 fish samples (Sde_CLim_110, Sde_CPla_115, Sde-CBau_104, Sde-CMat_203, Sde_CTlk_104)
//   - 3 beetle samples (golden_A01, mottled_B01, mottled_D01)
//
// Cluster: crest HPC
//   normal*:   26 nodes × 64 CPUs × 343 GB RAM (max 8 nodes at once, qos=normal)
//   bigmem:     2 nodes × 64 CPUs × 700 GB RAM (qos=highmem)
//   ultramem:   2 nodes × 64 CPUs × 1416 GB RAM (qos=highmem)
//
// Design principles:
//   - normal queue by default; attempt 1 always fits in 343 GB
//   - Dynamic memory with retry escalation to bigmem for variable processes
//   - stageInMode='copy' where scratch I/O (~1000x faster) helps random access
//   - CPUs sized to actual utilization, freeing nodes for parallelism
//   - With 8 normal nodes max, avoid requesting 64 CPUs unless truly needed
// ============================================================================

process {
  executor = 'slurm'
  queue = 'normal'
  scratch = '/scratch'
  errorStrategy = 'retry'
  //errorStrategy = 'terminate'
  maxRetries = 1
  queueSize = 50

  // DEBUG
  //withName: 'CONTACT_MAP_FINAL' {
  //  scratch = false
  //  errorStrategy = 'terminate'
  //}

  // =========================================================================
  // TIER 1: CPU-INTENSIVE, HIGH MEMORY
  // These processes genuinely use many cores and significant RAM
  // =========================================================================

  withLabel: hifiasm {
    conda = 'bioconda::hifiasm bioconda::gfatools'
    cpus = 48
    time = '4h'
    // Fish: 64-79 GB, Beetle: 59-72 GB — fits normal queue
    memory = { task.attempt == 1 ? 100.GB : 300.GB }
    queue  = { task.attempt == 1 ? 'normal' : 'bigmem' }
    clusterOptions = { task.attempt == 1 ? '' : '--qos=highmem' }
    stageInMode = 'copy'
  }

  withLabel: misassembly_correction {
    conda = 'bioconda::inspector'
    cpus = 48
    time = { task.attempt == 1 ? 24.h : 72.h }
    memory = { task.attempt == 1 ? 110.GB : 300.GB }
    queue  = { task.attempt == 1 ? 'normal' : 'bigmem' }
    clusterOptions = { task.attempt == 1 ? '' : '--qos=highmem' }
    stageInMode = 'copy'
  }

  withLabel: mapping_qc {
    conda = 'bioconda::minimap2 bioconda::samtools'
    cpus = 48
    time = '6h'
    // Fish: 71-81 GB, Beetle golden: 88 GB
    memory = '100 GB'
  }

  withLabel: map_hic {
    conda = 'bioconda::bwa-mem2 bioconda::samtools'
    cpus = 48
    time = '4h'
    // Fish phased hap ~90 GB; collapsed/bloated primary (~2 Gb ref) at -@48 peaks higher
    memory = '240 GB'
  }

  withLabel: purge_dups {
    conda = 'bioconda::purge_dups bioconda::minimap2 conda-forge::pigz'
    cpus = 48
    time = '4h'
    // Beetle golden: 92 GB peak
    memory = { task.attempt == 1 ? 110.GB : 300.GB }
    queue  = { task.attempt == 1 ? 'normal' : 'bigmem' }
    clusterOptions = { task.attempt == 1 ? '' : '--qos=highmem' }
    stageInMode = 'copy'
  }

  withLabel: 'teloclip' {
    conda = 'bioconda::teloclip bioconda::minimap2 bioconda::samtools'
    cpus   = 16
    time   = '12h'
    // Minimap2 index + alignment is memory-intensive for large genomes
    // Fish (~700 Mb): ~20 GB; larger genomes scale up
    memory = '32 GB'
  }

  // toggled build label
  withLabel: 'cactus_pangenome' {
      container        = params.pangenome_use_gpu ? 'docker://quay.io/comparative-genomics-toolkit/cactus:v3.1.4-gpu'
                                                  : 'docker://quay.io/comparative-genomics-toolkit/cactus:v3.1.4'
      containerOptions = params.pangenome_use_gpu ? '--nv' : null
      queue            = params.pangenome_use_gpu ? 'gpu'  : 'normal'
      clusterOptions   = params.pangenome_use_gpu ? '--gres=gpu:1' : ''
      cpus   = 32
      memory = '300 GB'
      time   = params.pangenome_use_gpu ? '24h' : '96h'   // gpu partition caps at 1 day
  }

  // CPU-only tools label for the stats step (vg/odgi live in the same image; no GPU needed)
  withLabel: 'cactus_tools' {
      container = 'docker://quay.io/comparative-genomics-toolkit/cactus:v3.1.4'
      queue     = 'normal'
      cpus   = 4
      memory = '32 GB'
      time   = '4h'
  }

  // label (variant catalog: vcfbub + vcfwave + bcftools + bgzip/tabix)
  // vcflib is PINNED: vcfwave does not exist before ~1.0.9 (1.0.1 ships only the older
  // vcfallelicprimitives), and an unpinned spec would solve happily and then die at runtime
  // with `vcfwave: command not found`. NB this changes the conda spec -> fresh env solve.
  // vcfwave's -t is deliberately NOT used -- its own help says threading usually makes it
  // slower. Parallelism comes from chunking the VCF instead (see pangenome_vcfwave_chunks),
  // so cpus here is the real degree of parallelism: N single-threaded vcfwave processes.
  // The uncapped single-core projection was ~95 h for a 41.4M-record catalog, so 16 cores
  // lands near 6 h before scheduling overhead. All the chunking happens INSIDE this one task
  // via xargs -P, so cpus is simply how many vcfwave processes run concurrently -- there is
  // no Nextflow scatter-gather here. Raising cpus to 32/64 is a one-line change, bounded by
  // queue time for a near-whole-node request, memory per concurrent process, and the serial
  // vcfbub / norm / sort / tabix phases.
  // time is set generously on purpose: the projection is ~6 h, and a decomposition this
  // expensive is not worth losing to a walltime kill on the first real run.
  withLabel: 'pangenome_variants' {
      conda  = 'bioconda::bcftools bioconda::vcfbub bioconda::vcflib=1.0.15 bioconda::htslib'
      cpus   = 16
      memory = { task.attempt == 1 ? 32.GB : 96.GB }
      time   = '96h'
  }

  withLabel: 'pangenome_hap_coverage' {
      // single-threaded, two streaming passes over the clip GFA; memory scales with NODE
      // COUNT (~20 B/node), not genome size, so this is generous for a vertebrate graph
      conda  = 'conda-forge::python=3.11 conda-forge::numpy'
      cpus   = 1
      memory = { task.attempt == 1 ? 32.GB : 96.GB }
      time   = '4h'
  }

  withLabel: 'panacus' {
      conda  = 'bioconda::panacus'
      cpus   = 8
      memory = '64 GB'
      time   = '4h'
  }

  // =========================================================================
  // TIER 2: CPU-INTENSIVE, MODERATE MEMORY
  // =========================================================================

  withLabel: busco {
    conda = 'bioconda::busco=5.3.2 bioconda::augustus=3.3'
    cpus = 48
    time = '4h'
    // Fish: 13-24 GB, Beetle golden: 50 GB — big lineage/genome variation
    memory = { task.attempt == 1 ? 55.GB : 100.GB }
    queue  = { task.attempt == 1 ? 'normal' : 'bigmem' }
    clusterOptions = { task.attempt == 1 ? '' : '--qos=highmem' }
    stageInMode = 'copy'
  }

  withLabel: bam_to_fastq {
    conda = 'bioconda::samtools'
    cpus = 32
    time = '1h'
    // Actual: <100 MB RSS everywhere
    memory = '4 GB'
  }

  // =========================================================================
  // TIER 3: MODERATE CPU, VARIABLE MEMORY
  // =========================================================================

  withLabel: merqury {
    conda = 'conda-forge::openjdk=11 bioconda::merqury'
    cpus = 8
    time = '4h'
    // Fish: 4-5 GB, Beetle golden: 16 GB — I/O bound, not CPU bound
    memory = '20 GB'
    stageInMode = 'copy'
  }

  // BUILD_MERYL_DB uses label 'merqury' but needs very different resources
  // withName takes precedence over withLabel
  withName: BUILD_MERYL_DB {
    cpus = 16
    time = '4h'
    // Fish: 31-34 GB, Beetle golden: 78 GB
    memory = { task.attempt == 1 ? 100.GB : 200.GB }
    queue  = { task.attempt == 1 ? 'normal' : 'bigmem' }
    clusterOptions = { task.attempt == 1 ? '' : '--qos=highmem' }
    stageInMode = 'copy'
  }

  withLabel: filter_hic_bam {
    conda = 'bioconda::pairtools bioconda::samtools'
    cpus = 32
    time = '8h'
    // Fish: 27 GB, Beetle golden: 22 GB — streaming I/O, not CPU intensive
    memory = '50 GB'
  }

  withLabel: gap_filling {
    conda = 'bioconda::tgsgapcloser'
    cpus = 12
    time = '6h'
    // Fish: 62-82 GB, Beetle golden: 141 GB — extreme genome-size variation
    memory = { task.attempt == 1 ? 150.GB : 343.GB }
    queue  = { task.attempt == 1 ? 'normal' : 'bigmem' }
    clusterOptions = { task.attempt == 1 ? '' : '--qos=highmem' }
  }

  withLabel: pairwise_alignment {
    conda = "${projectDir}/environments/pairwise_alignment.yaml"
    cpus = 16
    time = '2h'
    // Fish (5 samples, 45 comparisons): 22-38 GB, Beetle golden: 124 GB
    memory = { task.attempt == 1 ? 150.GB : 343.GB }
    queue  = { task.attempt == 1 ? 'normal' : 'bigmem' }
    clusterOptions = { task.attempt == 1 ? '' : '--qos=highmem' }
  }

  withLabel: coverage_book {
    conda = "${projectDir}/environments/coverage_book.yaml"
    cpus = 12
    time = '8h'
    // Fish: 20-22 GB, Beetle golden: 22 GB — consistent but long runtimes
    memory = '32 GB'
    stageInMode = 'copy'
  }

  withLabel: scaffold_hic {
    conda = 'bioconda::yahs bioconda::samtools'
    cpus = 1
    time = '1h'
    // Single-threaded. Fish: 2.4-6.3 GB, Beetle: 1-1.8 GB
    memory = '8 GB'
  }

  withLabel: fastp {
    conda = 'bioconda::fastp'
    cpus = 16
    time = '2h'
    // Fish: 1.5-1.6 GB, Beetle golden: 2.3 GB
    memory = '4 GB'
  }

  withLabel: subsample_shortreads {
    conda = 'bioconda::rasusa'
    cpus = 16
    time = '2h'
    // Fish: 1.5-1.6 GB, Beetle golden: 2.3 GB
    memory = '4 GB'
  }

  withLabel: genomescope {
    conda = 'genomescope2 kmer-jellyfish'
    cpus = 16
    time = '24h'
    // jellyfish count -s allocates a large hash upfront; scales with genome size.
    memory = { task.attempt == 1 ? 100.GB : 200.GB }
    queue  = 'normal'
  }

  // =========================================================================
  // TIER 4: HIGH MEMORY SPECIAL — must use bigmem/ultramem
  // These exceed the 343 GB normal queue limit
  // =========================================================================

  withLabel: fcs {
    container = 'https://ftp.ncbi.nlm.nih.gov/genomes/TOOLS/FCS/releases/latest/fcs-gx.sif'
    containerOptions = '--bind /work/birdlab:/work/birdlab'
    queue = 'ultramem,bigmem'
    clusterOptions = '--qos=highmem'
    cpus = 32
    time = '1h'
    // Fish: 367-384 GB, Beetle: 344-386 GB — dominated by DB size, always >343 GB
    memory = '500 GB'
  }

  withLabel: diamond {
    conda = 'bioconda::diamond conda-forge::curl conda-forge::pigz'
    cpus = 64
    time = '48h'
    memory = '150 GB'
  }

  withName: DIAMOND_BLASTX {
    conda = 'bioconda::diamond conda-forge::curl conda-forge::pigz'
    queue = 'bigmem'
    clusterOptions = '--qos=highmem'
    cpus = 64
    time = '48h'
    // Needs bigmem for nr database
    memory = '700 GB'
  }

  // ---- Short-read assembly (Phase 4a) ----
  withLabel: spades {
    conda = 'bioconda::spades'
    cpus = 64
    time = '96h'
    memory         = { spadesTier(meta, task.attempt).mem.GB }
    queue          = { spadesTier(meta, task.attempt).q   }
    clusterOptions = { spadesTier(meta, task.attempt).qos }
    stageInMode = 'copy'
  }

  withLabel: redundans {
    conda          = 'bioconda::redundans'
    cpus           = 24
    time           = '96h'
    memory         = '700 GB'
    queue  = 'bigmem,ultramem'
    clusterOptions = '--qos=highmem'
    stageInMode    = 'copy'
  }

  // pilon label (fastp + redundans labels already added / exist)
  withLabel: pilon {
      conda          = 'bioconda::pilon bioconda::bwa bioconda::samtools'
      cpus           = 64
      time           = '24h'
      memory = '1000 GB'
      queue = 'ultramem,bigmem'
      clusterOptions = '--qos=highmem'
      stageInMode    = 'copy'
  }

  // =========================================================================
  // TIER 5: LIGHTWEIGHT PROCESSES
  // Small enough to pack many per node for good parallelism
  // =========================================================================

  withLabel: 'pangenome_popstruct' {
      conda  = 'conda-forge::r-base conda-forge::r-ggplot2 conda-forge::r-ape conda-forge::r-ggrepel'
      cpus   = 2
      memory = '8 GB'
      time   = '1h'
  }

  withLabel: 'tidk' {
    conda = 'bioconda::tidk'
    cpus   = 2
    time   = '30m'
    memory = '4 GB'
  }

  withLabel: 'read_count' {
    conda = 'bioconda::seqkit'
    cpus = 16
    time = '2h'
    memory = '4 GB'
  }

   withLabel: 'mitohifi' {
       container = 'ghcr.io/marcelauliano/mitohifi:master'
       cpus = 16
       memory = '32 GB'
       time = '12h'
       queue = 'normal'
   }

   withLabel: mitos_download {
    conda  = 'conda-forge::curl conda-forge::tar conda-forge::bzip2'
    cpus   = 2
    memory = '4 GB'
    time   = '2h'
  }

  withLabel: mitos {
        conda  = 'bioconda::mitos'
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
        queue  = 'normal'
  }

  withLabel: chloe {
    conda  = "${projectDir}/environments/chloe.yml"
    cpus   = 8
    memory = '16 GB'
    time   = '4h'
    queue  = 'normal'
  }

  withLabel: tiny {
    cpus   = 1
    memory = '500 MB'
    time   = '15m'
  }

   withLabel: 'filter_mito_contigs' {
       conda = 'bioconda::minimap2 bioconda::samtools'
       cpus = 8
       memory = '16 GB'
       time = '2h'
       queue = 'normal'
  }

  withLabel: 'mito_circular_map' {
        conda = 'conda-forge::pycirclize conda-forge::biopython'
        cpus = 1
        memory = '4 GB'
        time = '30m'
        queue = 'normal'
    }

  withLabel: getorganelle {
    conda  = 'bioconda::getorganelle=1.7.7.1'
    cpus   = 16
    memory = '32 GB'
    time   = '8h'
    queue  = 'normal'
  }

  withLabel: getorganelle_download {
    conda  = 'bioconda::getorganelle=1.7.7.1'
    cpus   = 2
    memory = '4 GB'
    time   = '2h'
  }

  withLabel: fastqc {
    conda = 'bioconda::fastqc'
    cpus = 4
    time = { 2.h * task.attempt }   // 2h → 4h → 6h across attempts; was fixed '1h'
    // Fish: 1.5-2.3 GB, Beetle: 1.5-2.1 GB
    memory = '4 GB'
  }

  withLabel: quast {
    conda = 'bioconda::quast'
    cpus = 4
    time = '15m'
    // Single-sample: 2-6 GB; QUAST_FINAL scales with sample count (10.7 GB for 5 samples)
    memory = '16 GB'
  }

  withLabel: multiqc {
    conda = 'bioconda::multiqc'
    cpus = 4
    time = '30m'
    memory = '4 GB'
  }

  withLabel: taxonkit {
    conda  = 'taxonkit=0.15.1 csvtk'
    cpus   = 1
    memory = { 2.GB  * task.attempt }
    time   = { 30.min * task.attempt }
  }

  withLabel: snail_plot {
    conda = "${projectDir}/environments/blobtoolkit.yaml"
    cpus = 2
    time = '15m'
    // Fish: 76-369 MB, Beetle golden: 757 MB
    memory = '2 GB'
  }

  withLabel: telomere_scan {
    cpus = 1
    time = '15m'
    memory = '2 GB'
  }

  withLabel: summarize_assembly {
    conda = 'conda-forge::r-base=4.3 conda-forge::r-tidyverse conda-forge::r-jsonlite conda-forge::r-argparse'
    cpus = 4
    time = '30m'
    memory = '4 GB'
  }

  withLabel: combine_hic_qc {
    conda = 'conda-forge::r-base conda-forge::r-tidyverse conda-forge::r-rmarkdown'
    cpus = 4
    time = '30m'
    memory = '4 GB'
  }

  // =========================================================================
  // TIER 6: HI-C QC PROCESSES
  // =========================================================================

  withLabel: hic_qc {
    conda = 'bioconda::samtools'
    cpus = 2
    time = '4h'
    // BAM_METRICS: <10 MB, 13-17m (I/O streaming); PAIRS_METRICS: <10 MB, <1m
    memory = '10 GB'
  }

  withLabel: hic_contact_map {
    conda = 'bioconda::cooler bioconda::hicexplorer bioconda::pairtools'
    cpus = 4
    time = '30m'
    // Fish: 13-18 GB, Beetle golden: 31 GB
    memory = '40 GB'
  }

  withLabel: hic_pair_stats {
    conda = 'bioconda::samtools conda-forge::r-base conda-forge::r-ggplot2 conda-forge::r-dplyr conda-forge::r-gridextra'
    cpus = 4
    time = '1h'
    memory = '4 GB'
  }

  withLabel: hic_coverage {
    conda = 'bioconda::samtools bioconda::bedtools conda-forge::r-base conda-forge::r-ggplot2 conda-forge::r-dplyr'
    cpus = 4
    time = '2h'
    memory = '4 GB'
  }

  withLabel: hic_liftover_pairs {
    conda = "${projectDir}/environments/hic_liftover_pairs.yaml"
    cpus = 16
    time = '2h'
    // Actual: 2.5-12 GB
    memory = '16 GB'
  }

  // =========================================================================
  // TIER 7: DATABASE & UTILITY PROCESSES
  // =========================================================================

  withLabel: busco_download {
    conda = 'bioconda::busco'
    cpus = 2
    time = '2h'
    memory = '4 GB'
  }

  withLabel: download_db {
    conda = 'conda-forge::curl conda-forge::tar'
    cpus = 4
    time = '4h'
    memory = '8 GB'
  }

  withLabel: blobtools {
    conda = 'bioconda::blobtoolkit'
    cpus = 8
    time = '12h'
    memory = '32 GB'
  }

  withLabel: 'summary_report' {
    cpus = 4
    memory = '16 GB'
    time = '2h'
    conda = "${projectDir}/environments/report.yaml"
  }

  withLabel: 'assembly_report' {
      conda = 'python>=3.8'
      cpus = 1
      time = '30m'
      memory = '2 GB'
  }

  withLabel: 'summarize_assembly' {
      cpus = 1
      time = '30m'
      memory = '1 GB'
  }

  withLabel: harmonize_candidates {
    // fai parsing and a table sort -- no alignment
    conda   = 'bioconda::samtools conda-forge::python=3.10'
    cpus    = 2
    time    = '1h'
    memory  = '8 GB'
  }

  withLabel: 'harmonize_scaffolds' {
      conda   = 'bioconda::minimap2 bioconda::samtools conda-forge::python=3.10'
      cpus    = 8
      time    = '8h'
      memory  = '32 GB'
  }

  withLabel: 'finalize_assembly' {
      conda = 'bioconda::samtools bioconda::seqkit'
      cpus = 1
      time = '1h'
      memory = '4 GB'
  }

  // =========================================================================
  // PROCESS-NAME OVERRIDES
  // For processes that share a label but need different resources
  // withName always takes precedence over withLabel
  // =========================================================================

  withName: SETUP_PAFR {
    cpus = 2
    time = '30m'
    memory = '4 GB'
  }

  withName: FCS_ADAPTOR {
    conda = 'conda-forge::bash conda-forge::curl coreutils'
    cpus = 8
    time = '24h'
    memory = '32 GB'
  }

  withName: FCS_BLOB_EVIDENCE_REPORT {
    conda = 'conda-forge::python=3.11'
    cpus = 2
    time = '2h'
    memory = '8 GB'
  }
}

conda {
  enabled = true
  cacheDir = '/work/birdlab/.conda_builds'
  autoActivate = true
  //channels = ['bioconda', 'conda-forge', 'defaults']
  conda.channels = ['conda-forge', 'bioconda', 'defaults'] 
  createTimeout = '6 h'
}

singularity {
  enabled = true
  autoMounts = true
  cacheDir = '/work/birdlab/singularity_cache'
  runOptions = '--cleanenv'
  envWhitelist = 'SINGULARITY_BINDPATH,SINGULARITY_LD_LIBRARY_PATH'
}

profiles {
  slurm {
    process.executor = 'slurm'
    conda.enabled = true
    singularity.enabled = true
  }
  local {
    process.executor = 'local'
    process.cpus = 4
    conda.enabled = true
    singularity.enabled = true
  }
  docker {
    docker.enabled = true
    process.container = 'quay.io/biocontainers/nextflow:latest'
  }
}

timeline {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_trace.txt"
}
dag {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_dag.png"
}